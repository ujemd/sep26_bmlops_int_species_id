# Copy to .env and adjust. Never commit .env.
AIRFLOW_UID=1000                 # output of `id -u`, so Airflow can write to ./data
POSTGRES_PASSWORD=species
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=change-me
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
GRAFANA_PASSWORD=admin
DOCKERHUB_USER=local

# Optional: track experiments on DagsHub instead of the local MLflow server
# MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
# MLFLOW_TRACKING_USERNAME=<user>
# MLFLOW_TRACKING_PASSWORD=<dagshub token>
